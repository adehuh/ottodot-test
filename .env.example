# Two connection strings, deliberately (ARCHITECTURE R5.1).
#
# DIRECT (:5432 locally :54322) — migrations, seeds and tests.
#   Session-mode connection. Supports BEGIN ... FOR UPDATE ... COMMIT,
#   named statements, and everything the pooler drops.
#
# POOLER (:6543) — the deployed app on Vercel.
#   Transaction-mode pgBouncer. Required for serverless, where every
#   isolate would otherwise hold its own idle connection.
#
# Never pass `name:` to a pg query (R5.2): transaction-mode pgBouncer
# does not support named prepared statements.

# The app. Locally this is the direct string; on Vercel it is the pooler.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Migrations, seeds and tests. Always direct, never the pooler.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Integration tests. Each test file creates and drops its own schema here.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# On Vercel the pooler string looks like:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
